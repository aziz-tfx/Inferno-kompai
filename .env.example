# --- amoCRM ---
# Базовый адрес вашего аккаунта amoCRM (без слэша в конце).
# Пример: https://inferno.amocrm.ru
AMO_BASE_URL=https://your-subdomain.amocrm.ru

# Долгосрочный токен доступа (long-lived access token).
# Создаётся в amoCRM: Настройки → Интеграции → ваша интеграция → вкладка «Ключи и доступы».
AMO_ACCESS_TOKEN=your-long-lived-access-token

# (необязательно) ID воронки, в которую попадает сделка.
# Если не указать — сделка попадёт в основную воронку по умолчанию.
AMO_PIPELINE_ID=

# (необязательно) ID статуса (этапа) в воронке для новой сделки.
AMO_STATUS_ID=

# (необязательно) ID ответственного пользователя, на которого назначается сделка.
AMO_RESPONSIBLE_USER_ID=

# --- Сервер ---
PORT=3000

# Разрешённые источники для CORS (домены лендинга), через запятую.
# Пример: https://inferno-kompai.ru,https://www.inferno-kompai.ru
# Оставьте пустым или "*" чтобы разрешить все источники (для теста).
CORS_ORIGINS=*
